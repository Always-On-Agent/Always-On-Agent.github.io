+    if (activeModalStack.length) stopMovement()
+  })
+  let cleaned = false
+  const cleanup = () => {
+    if (cleaned) return
+    cleaned = true
+    clearInterval(observer)
+    abort.abort()
+    unsubscribeModal()
+    stopMovement()
